; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Alchemia"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

GlobalSignals="*uid://xeu0o4n6blkj"
Equipment="*uid://cijwx6gq8ttwl"
Player="*uid://dvdthx6h2wg22"
GameManager="*uid://hl8eeyascdaq"

[editor_plugins]

enabled=PackedStringArray("res://addons/at-icons/plugin.cfg", "res://addons/gut/plugin.cfg")

[file_customization]

folder_colors={
"res://Resources/": "teal",
"res://Scenes/": "green",
"res://Script/": "orange"
}
